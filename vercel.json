{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/lineup", "destination": "/#ladies", "permanent": true },
    { "source": "/lineup/", "destination": "/#ladies", "permanent": true },
    { "source": "/lineup.html", "destination": "/#ladies", "permanent": true }
  ]
}
